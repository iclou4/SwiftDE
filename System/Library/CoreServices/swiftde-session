#!/bin/sh
# swiftde-session — SwiftDE login session (Wayfire, no GNOME).
export XDG_CURRENT_DESKTOP=SwiftDE
export XDG_SESSION_DESKTOP=swiftde
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1
export QSG_RHI_BACKEND=opengl
export MOZ_ENABLE_WAYLAND=1
export XCURSOR_THEME=SwiftDE
export XCURSOR_SIZE=24
export XCURSOR_PATH="$HOME/.icons:/usr/share/icons"

export GSK_RENDERER=gl
export XDG_SESSION_TYPE=wayland

# Register session variables with D-Bus and systemd --user so GTK/GNOME apps launch
dbus-update-activation-environment --systemd --all 2>/dev/null || true
systemctl --user import-environment 2>/dev/null || true

SWIFTDE_DIR="${SWIFTDE_ROOT:-$HOME/SwiftDE}"
/usr/local/bin/wayfire -c "$SWIFTDE_DIR/System/Library/Preferences/swiftde.ini"

# When session ends (logout), restart GDM to cleanly autologin into the lock screen
sudo systemctl restart gdm3
